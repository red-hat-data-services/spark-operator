# Build args for ODH flow
ARG GO_BUILDER_IMAGE=registry.access.redhat.com/ubi10/go-toolset@sha256:fc4a3dfb8f562065cd3e31e2b4544fe1144baef84529adaf3245fac68d7a193d
# UBI 10 Python minimal — RHEL 10 has PQC crypto by default (no ubi-minimal-pqc / crypto-policies step).
ARG BASE_IMAGE=registry.access.redhat.com/ubi10/python-312-minimal@sha256:16cd9d766f812e706f4994aaacb656d338b1054952dcd0ce9627c32011d9574e

################################################################################
# Stage 1: Build the Go operator binary
################################################################################
FROM ${GO_BUILDER_IMAGE} AS builder

USER 0
WORKDIR /workspace

RUN --mount=type=cache,target=/go/pkg/mod/ \
    --mount=type=bind,source=.,target=. \
    go mod download

COPY . .

ENV GOCACHE=/root/.cache/go-build
ARG TARGETARCH
ARG GOTAGS="distro"

RUN --mount=type=cache,target=/go/pkg/mod/ \
    --mount=type=cache,target="/root/.cache/go-build" \
    CGO_ENABLED=1 GOOS=linux GOARCH=${TARGETARCH} GOEXPERIMENT=strictfipsruntime go build -tags "${GOTAGS},strictfipsruntime" -o bin/spark-operator cmd/operator/main.go

################################################################################
# Stage 2: Runtime image (ODH-style)
################################################################################
FROM ${BASE_IMAGE} AS runtime

ARG SPARK_UID=185
ARG SPARK_GID=185
ARG PYSPARK_VERSION=4.0.4

USER 0

# shadow-utils provides groupadd/useradd; bash is the spark user shell.
# Java 21 (UBI 10 has no Java 17). Podman provides catatonit.
RUN microdnf install -y shadow-utils bash java-21-openjdk-devel podman && \
    microdnf clean all && rm -rf /var/cache/dnf/*

# Create spark user/group with SPARK_UID if needed
RUN if getent group "${SPARK_UID}" > /dev/null 2>&1; then \
        EXISTING_GROUP=$(getent group "${SPARK_UID}" | cut -d: -f1); \
        groupmod -n spark "$EXISTING_GROUP"; \
    else \
        groupadd -g "${SPARK_UID}" spark; \
    fi && \
    if getent passwd "${SPARK_UID}" > /dev/null 2>&1; then \
        EXISTING_USER=$(getent passwd "${SPARK_UID}" | cut -d: -f1); \
        usermod -l spark -d /home/spark "$EXISTING_USER"; \
    else \
        useradd -u "${SPARK_UID}" -g spark -d /home/spark -s /bin/bash spark; \
    fi && \
    mkdir -p /home/spark && \
    chown spark:spark /home/spark

ENV JAVA_HOME="/usr/lib/jvm/java-21" \
    JAVA_VENDOR="openjdk" \
    JAVA_VERSION="21"
ENV PATH="${JAVA_HOME}/bin:${PATH}:/usr/libexec/podman"

# Verify catatonit is available
RUN catatonit --version

# Install PySpark and stage Spark layout
RUN pip3 install --no-cache-dir pyspark==${PYSPARK_VERSION}
ENV SPARK_HOME=/opt/spark
RUN PYSPARK_DIR=$(python3 -c "import pyspark; import os; print(os.path.dirname(pyspark.__file__))") && \
    cp -r "${PYSPARK_DIR}" /opt/spark && \
    mkdir -p /opt/spark/work-dir /opt/spark/logs && \
    echo "Spark ${PYSPARK_VERSION} (PySpark)" > /opt/spark/RELEASE && \
    chown -R spark:spark /opt/spark/work-dir /opt/spark/logs /opt/spark/RELEASE
ENV PATH="${PATH}:${SPARK_HOME}/bin:${SPARK_HOME}/sbin"

# Webhook certs directory
RUN mkdir -p /etc/k8s-webhook-server/serving-certs && \
    chmod -R g+rw /etc/k8s-webhook-server/serving-certs && \
    chown -R spark /etc/k8s-webhook-server/serving-certs /home/spark

# OpenShift arbitrary UID compatibility
RUN chgrp -R 0 /opt/spark/work-dir /opt/spark/logs /etc/k8s-webhook-server && \
    chmod -R g=u /opt/spark/work-dir /opt/spark/logs /etc/k8s-webhook-server && \
    chmod -R 775 /opt/spark/work-dir /opt/spark/logs

# Operator binary and entrypoint
COPY --from=builder /workspace/bin/spark-operator /usr/bin/spark-operator
COPY entrypoint.sh /usr/bin/

USER ${SPARK_UID}:${SPARK_GID}
ENTRYPOINT ["/usr/bin/entrypoint.sh"]

# Preserve Konflux labels
LABEL com.redhat.component="odh-spark-operator-rhel10" \
      name="managed-open-data-hub/odh-spark-operator-rhel10" \
      description="This image contains the Spark Operator controller. It watches for SparkApplication Custom Resources (CRDs) and automates the submission, monitoring, and scaling of Spark driver and executor pods on the cluster." \
      summary="odh-spark-operator-rhel10" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-spark-operator" \
      io.k8s.description="odh-spark-operator-rhel10" \
      distribution-scope="public" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
